  {"id": "l9-051", "type": "word", "pt": "como", "en": "how; like, as", "level": 9, "unit": "l9-questions", "topic": "questions", "example": {"pt": "Como vais para o trabalho?", "en": "How do you get to work?"}, "blank": "Como", "verified": false},
  {"id": "l9-052", "type": "word", "pt": "qual", "en": "which, what", "level": 9, "unit": "l9-questions", "topic": "questions", "note": "*Qual é* o teu número? = what's your number?", "example": {"pt": "Qual preferes, o azul ou o verde?", "en": "Which do you prefer, the blue or the green?"}, "blank": "Qual", "verified": false},
  {"id": "l9-053", "type": "word", "pt": "tudo", "en": "everything", "level": 9, "unit": "l9-questions", "topic": "amounts", "example": {"pt": "Comeste tudo?", "en": "Did you eat everything?"}, "blank": "tudo", "verified": false},
  {"id": "l9-054", "type": "word", "pt": "nada", "en": "nothing", "level": 9, "unit": "l9-questions", "topic": "amounts", "note": "After a verb you need *não* too: *não* quero *nada*.", "example": {"pt": "Não quero nada, obrigado.", "en": "I don't want anything, thanks."}, "blank": "nada", "verified": false},
  {"id": "l9-055", "type": "word", "pt": "alguém", "en": "someone, anyone", "level": 9, "unit": "l9-questions", "topic": "amounts", "example": {"pt": "Alguém viu as minhas chaves?", "en": "Has anyone seen my keys?"}, "blank": "Alguém", "verified": false},
