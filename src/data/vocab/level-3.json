  {"id": "l3-018", "type": "word", "pt": "febre", "gender": "f", "en": "fever, temperature", "level": 3, "unit": "l3-health", "topic": "health", "example": {"pt": "O miúdo tem febre.", "en": "The kid has a temperature."}, "blank": "febre", "verified": false},
