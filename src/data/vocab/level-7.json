[
  {"id": "l7-001", "type": "word", "pt": "ser", "en": "to be (who or what something is)", "level": 7, "unit": "l7-basics", "topic": "verbs", "note": "For what something is or is like: *sou* professor, *é* bonito. See Grammar: ser or estar.", "example": {"pt": "A Ana é professora.", "en": "Ana is a teacher."}, "blank": "é", "verified": false},
  {"id": "l7-002", "type": "word", "pt": "estar", "en": "to be (a state or a place)", "level": 7, "unit": "l7-basics", "topic": "verbs", "note": "For how or where something is right now: *estou* cansado, *está* em casa.", "example": {"pt": "Hoje estou muito cansado.", "en": "Today I'm very tired."}, "blank": "estou", "verified": false},
  {"id": "l7-003", "type": "word", "pt": "ter", "en": "to have", "level": 7, "unit": "l7-basics", "topic": "verbs", "note": "*Ter de* + verb = to have to: *tenho de* sair.", "example": {"pt": "Tenho dois irmãos.", "en": "I have two brothers."}, "blank": "Tenho", "verified": false},
  {"id": "l7-004", "type": "word", "pt": "haver", "en": "there to be (there is, there are)", "level": 7, "unit": "l7-basics", "topic": "verbs", "note": "Almost always heard as *há*: *há* pão? = is there any bread?", "example": {"pt": "Há um café nesta rua.", "en": "There's a café in this street."}, "blank": "Há", "verified": false},
  {"id": "l7-005", "type": "word", "pt": "ir", "en": "to go", "level": 7, "unit": "l7-basics", "topic": "verbs", "example": {"pt": "Vamos à praia no sábado.", "en": "We're going to the beach on Saturday."}, "blank": "Vamos", "verified": false},
  {"id": "l7-006", "type": "word", "pt": "vir", "en": "to come", "level": 7, "unit": "l7-basics", "topic": "verbs", "example": {"pt": "Vens jantar connosco?", "en": "Are you coming to dinner with us?"}, "blank": "Vens", "verified": false},
  {"id": "l7-007", "type": "word", "pt": "fazer", "en": "to do, to make", "level": 7, "unit": "l7-basics", "topic": "verbs", "example": {"pt": "O que fazes ao domingo?", "en": "What do you do on Sundays?"}, "blank": "fazes", "verified": false},
  {"id": "l7-008", "type": "word", "pt": "dar", "en": "to give", "level": 7, "unit": "l7-basics", "topic": "verbs", "example": {"pt": "Vou dar um livro à Rita.", "en": "I'm going to give Rita a book."}, "blank": "dar", "verified": false},
  {"id": "l7-009", "type": "word", "pt": "ficar", "en": "to stay; to be located", "level": 7, "unit": "l7-basics", "topic": "verbs", "note": "Also 'to be located': o hotel *fica* perto. See Grammar: ficar.", "example": {"pt": "Hoje fico em casa.", "en": "Today I'm staying at home."}, "blank": "fico", "verified": false},
  {"id": "l7-010", "type": "word", "pt": "ver", "en": "to see, to watch", "level": 7, "unit": "l7-basics", "topic": "verbs", "example": {"pt": "Vejo televisão à noite.", "en": "I watch television in the evening."}, "blank": "Vejo", "verified": false},
  {"id": "l7-011", "type": "word", "pt": "dizer", "en": "to say, to tell", "level": 7, "unit": "l7-basics", "topic": "verbs", "example": {"pt": "Ela diz que está cansada.", "en": "She says she's tired."}, "blank": "diz", "verified": false},
  {"id": "l7-012", "type": "phrase", "pt": "Tenho de ir.", "en": "I have to go.", "level": 7, "unit": "l7-basics", "topic": "verbs", "alternatives": ["Tenho que ir."], "note": "*Tenho que* is also common in speech.", "example": {"pt": "Já é tarde. Tenho de ir.", "en": "It's late already. I have to go."}, "blank": "ir", "verified": false},
  {"id": "l7-013", "type": "word", "pt": "querer", "en": "to want", "level": 7, "unit": "l7-mind", "topic": "verbs", "note": "When ordering, *queria* sounds more polite than *quero*.", "example": {"pt": "Queres um café?", "en": "Do you want a coffee?"}, "blank": "Queres", "verified": false},
  {"id": "l7-014", "type": "word", "pt": "poder", "en": "can, to be able to", "level": 7, "unit": "l7-mind", "topic": "verbs", "example": {"pt": "Posso abrir a janela?", "en": "Can I open the window?"}, "blank": "Posso", "verified": false},
  {"id": "l7-015", "type": "word", "pt": "saber", "en": "to know (a fact, how to do something)", "level": 7, "unit": "l7-mind", "topic": "verbs", "note": "To know a person or a place: *conhecer*.", "example": {"pt": "Sabes onde fica o banco?", "en": "Do you know where the bank is?"}, "blank": "Sabes", "verified": false},
  {"id": "l7-016", "type": "word", "pt": "conhecer", "en": "to know (a person, a place), to meet", "level": 7, "unit": "l7-mind", "topic": "verbs", "example": {"pt": "Conheces o Porto?", "en": "Do you know Porto?"}, "blank": "Conheces", "verified": false},
  {"id": "l7-017", "type": "word", "pt": "pensar", "en": "to think (about)", "level": 7, "unit": "l7-mind", "topic": "verbs", "note": "For an opinion people usually say *acho que*.", "example": {"pt": "Penso muito na minha família.", "en": "I think about my family a lot."}, "blank": "Penso", "verified": false},
  {"id": "l7-018", "type": "word", "pt": "perceber", "en": "to understand", "level": 7, "unit": "l7-mind", "topic": "verbs", "alternatives": ["entender"], "note": "The everyday word in Portugal; *entender* is also used.", "example": {"pt": "Desculpa, não percebi.", "en": "Sorry, I didn't understand."}, "blank": "percebi", "verified": false},
  {"id": "l7-019", "type": "word", "pt": "lembrar-se", "en": "to remember", "level": 7, "unit": "l7-mind", "topic": "verbs", "alternatives": ["lembrar"], "note": "Usually with *de*: *lembras-te do* nome dele?", "example": {"pt": "Lembras-te do nome dele?", "en": "Do you remember his name?"}, "blank": "Lembras-te", "verified": false},
  {"id": "l7-020", "type": "word", "pt": "esquecer-se", "en": "to forget", "level": 7, "unit": "l7-mind", "topic": "verbs", "alternatives": ["esquecer"], "example": {"pt": "Esqueci-me da chave.", "en": "I forgot the key."}, "blank": "Esqueci-me", "verified": false},
  {"id": "l7-021", "type": "word", "pt": "gostar", "en": "to like", "level": 7, "unit": "l7-mind", "topic": "verbs", "note": "Always with *de*: *gosto de* peixe.", "example": {"pt": "Gosto muito de peixe.", "en": "I really like fish."}, "blank": "Gosto", "verified": false},
  {"id": "l7-022", "type": "word", "pt": "precisar", "en": "to need", "level": 7, "unit": "l7-mind", "topic": "verbs", "note": "With *de* before a noun: *preciso de* ajuda.", "example": {"pt": "Preciso de ajuda.", "en": "I need help."}, "blank": "Preciso", "verified": false},
  {"id": "l7-023", "type": "word", "pt": "preferir", "en": "to prefer", "level": 7, "unit": "l7-mind", "topic": "verbs", "example": {"pt": "Prefiro chá a café.", "en": "I prefer tea to coffee."}, "blank": "Prefiro", "verified": false},
  {"id": "l7-024", "type": "phrase", "pt": "Não me lembro.", "en": "I don't remember.", "level": 7, "unit": "l7-mind", "topic": "verbs", "example": {"pt": "Onde deixei o carro? Não me lembro.", "en": "Where did I leave the car? I don't remember."}, "blank": "lembro", "verified": false},
  {"id": "l7-025", "type": "word", "pt": "sair", "en": "to go out, to leave", "level": 7, "unit": "l7-moving", "topic": "verbs", "example": {"pt": "Saímos às nove.", "en": "We're going out at nine."}, "blank": "Saímos", "verified": false},
  {"id": "l7-026", "type": "word", "pt": "entrar", "en": "to go in, to come in", "level": 7, "unit": "l7-moving", "topic": "verbs", "example": {"pt": "Entra, a porta está aberta.", "en": "Come in, the door's open."}, "blank": "Entra", "verified": false},
  {"id": "l7-027", "type": "word", "pt": "chegar", "en": "to arrive", "level": 7, "unit": "l7-moving", "topic": "verbs", "example": {"pt": "O comboio chega às dez.", "en": "The train arrives at ten."}, "blank": "chega", "verified": false},
  {"id": "l7-028", "type": "word", "pt": "voltar", "en": "to come back, to go back", "level": 7, "unit": "l7-moving", "topic": "verbs", "example": {"pt": "Espera aqui, já volto.", "en": "Wait here, I'll be right back."}, "blank": "volto", "verified": false},
  {"id": "l7-029", "type": "word", "pt": "partir", "en": "to leave (on a journey); to break", "level": 7, "unit": "l7-moving", "topic": "verbs", "note": "Also 'to break': *parti* um copo.", "example": {"pt": "O avião parte às seis.", "en": "The plane leaves at six."}, "blank": "parte", "verified": false},
  {"id": "l7-030", "type": "word", "pt": "passar", "en": "to pass, to go by; to spend (time)", "level": 7, "unit": "l7-moving", "topic": "verbs", "example": {"pt": "Passei o fim de semana em Sintra.", "en": "I spent the weekend in Sintra."}, "blank": "Passei", "verified": false},
  {"id": "l7-031", "type": "word", "pt": "levar", "en": "to take (somewhere), to carry", "level": 7, "unit": "l7-moving", "topic": "verbs", "example": {"pt": "Levo o guarda-chuva, vai chover.", "en": "I'm taking the umbrella, it's going to rain."}, "blank": "Levo", "verified": false},
  {"id": "l7-032", "type": "word", "pt": "trazer", "en": "to bring", "level": 7, "unit": "l7-moving", "topic": "verbs", "example": {"pt": "Trazes o pão?", "en": "Will you bring the bread?"}, "blank": "Trazes", "verified": false},
  {"id": "l7-033", "type": "word", "pt": "pôr", "en": "to put", "level": 7, "unit": "l7-moving", "topic": "verbs", "example": {"pt": "Põe a mala aqui.", "en": "Put the suitcase here."}, "blank": "Põe", "verified": false},
  {"id": "l7-034", "type": "word", "pt": "subir", "en": "to go up, to climb", "level": 7, "unit": "l7-moving", "topic": "verbs", "example": {"pt": "Subimos a pé até ao castelo.", "en": "We walked up to the castle."}, "blank": "Subimos", "verified": false},
  {"id": "l7-035", "type": "word", "pt": "descer", "en": "to go down, to get off", "level": 7, "unit": "l7-moving", "topic": "verbs", "example": {"pt": "Desço na próxima paragem.", "en": "I'm getting off at the next stop."}, "blank": "Desço", "verified": false},
  {"id": "l7-036", "type": "phrase", "pt": "Estou a chegar.", "en": "I'm nearly there.", "level": 7, "unit": "l7-moving", "topic": "verbs", "example": {"pt": "Desculpa o atraso, estou a chegar.", "en": "Sorry I'm late, I'm nearly there."}, "blank": "chegar", "verified": false},
  {"id": "l7-037", "type": "word", "pt": "falar", "en": "to speak, to talk", "level": 7, "unit": "l7-talk", "topic": "verbs", "example": {"pt": "Falas inglês?", "en": "Do you speak English?"}, "blank": "Falas", "verified": false},
  {"id": "l7-038", "type": "word", "pt": "perguntar", "en": "to ask (a question)", "level": 7, "unit": "l7-talk", "topic": "verbs", "note": "To ask for something: *pedir*.", "example": {"pt": "Vou perguntar ao empregado.", "en": "I'll ask the waiter."}, "blank": "perguntar", "verified": false},
  {"id": "l7-039", "type": "word", "pt": "pedir", "en": "to ask for, to order", "level": 7, "unit": "l7-talk", "topic": "verbs", "example": {"pt": "Vamos pedir a conta.", "en": "Let's ask for the bill."}, "blank": "pedir", "verified": false},
  {"id": "l7-040", "type": "word", "pt": "responder", "en": "to answer, to reply", "level": 7, "unit": "l7-talk", "topic": "verbs", "example": {"pt": "Ele ainda não respondeu à mensagem.", "en": "He still hasn't replied to the message."}, "blank": "respondeu", "verified": false},
  {"id": "l7-041", "type": "word", "pt": "explicar", "en": "to explain", "level": 7, "unit": "l7-talk", "topic": "verbs", "example": {"pt": "Podes explicar outra vez?", "en": "Can you explain again?"}, "blank": "explicar", "verified": false},
  {"id": "l7-042", "type": "word", "pt": "contar", "en": "to tell (a story); to count", "level": 7, "unit": "l7-talk", "topic": "verbs", "example": {"pt": "Conta-me tudo!", "en": "Tell me everything!"}, "blank": "Conta-me", "verified": false},
  {"id": "l7-043", "type": "word", "pt": "ouvir", "en": "to hear, to listen (to)", "level": 7, "unit": "l7-talk", "topic": "verbs", "note": "*Oiço* and *ouço* are both used for 'I hear'.", "example": {"pt": "Ouço música no comboio.", "en": "I listen to music on the train."}, "blank": "Ouço", "verified": false},
  {"id": "l7-044", "type": "word", "pt": "ajudar", "en": "to help", "level": 7, "unit": "l7-talk", "topic": "verbs", "example": {"pt": "Posso ajudar?", "en": "Can I help?"}, "blank": "ajudar", "verified": false},
  {"id": "l7-045", "type": "word", "pt": "esperar", "en": "to wait (for); to hope", "level": 7, "unit": "l7-talk", "topic": "verbs", "note": "Also 'to hope': *espero* que sim.", "example": {"pt": "Espera por mim!", "en": "Wait for me!"}, "blank": "Espera", "verified": false},
  {"id": "l7-046", "type": "word", "pt": "encontrar", "en": "to find; to meet", "level": 7, "unit": "l7-talk", "topic": "verbs", "example": {"pt": "Não encontro as chaves.", "en": "I can't find the keys."}, "blank": "encontro", "verified": false},
  {"id": "l7-047", "type": "word", "pt": "mostrar", "en": "to show", "level": 7, "unit": "l7-talk", "topic": "verbs", "example": {"pt": "Mostra-me as fotografias.", "en": "Show me the photos."}, "blank": "Mostra-me", "verified": false},
  {"id": "l7-048", "type": "phrase", "pt": "Fala mais devagar, por favor.", "en": "Speak more slowly, please.", "level": 7, "unit": "l7-talk", "topic": "verbs", "formality": "informal", "alternatives": ["Por favor, fala mais devagar."], "note": "Polite form: *Fale mais devagar, por favor.*", "example": {"pt": "Desculpa, não percebi. Fala mais devagar, por favor.", "en": "Sorry, I didn't understand. Speak more slowly, please."}, "blank": "devagar", "verified": false},
  {"id": "l7-049", "type": "word", "pt": "comer", "en": "to eat", "level": 7, "unit": "l7-daily", "topic": "verbs", "example": {"pt": "Comemos às oito.", "en": "We eat at eight."}, "blank": "Comemos", "verified": false},
  {"id": "l7-050", "type": "word", "pt": "beber", "en": "to drink", "level": 7, "unit": "l7-daily", "topic": "verbs", "example": {"pt": "Bebes alguma coisa?", "en": "Will you have something to drink?"}, "blank": "Bebes", "verified": false},
  {"id": "l7-051", "type": "word", "pt": "dormir", "en": "to sleep", "level": 7, "unit": "l7-daily", "topic": "verbs", "example": {"pt": "Durmo oito horas por noite.", "en": "I sleep eight hours a night."}, "blank": "Durmo", "verified": false},
  {"id": "l7-052", "type": "word", "pt": "ler", "en": "to read", "level": 7, "unit": "l7-daily", "topic": "verbs", "example": {"pt": "Leio o jornal ao pequeno-almoço.", "en": "I read the paper at breakfast."}, "blank": "Leio", "verified": false},
  {"id": "l7-053", "type": "word", "pt": "escrever", "en": "to write", "level": 7, "unit": "l7-daily", "topic": "verbs", "example": {"pt": "Escreve-me quando chegares.", "en": "Write to me when you arrive."}, "blank": "Escreve-me", "verified": false},
  {"id": "l7-054", "type": "word", "pt": "comprar", "en": "to buy", "level": 7, "unit": "l7-daily", "topic": "verbs", "example": {"pt": "Tenho de comprar pão.", "en": "I have to buy bread."}, "blank": "comprar", "verified": false},
  {"id": "l7-055", "type": "word", "pt": "pagar", "en": "to pay", "level": 7, "unit": "l7-daily", "topic": "verbs", "example": {"pt": "Quem paga hoje?", "en": "Who's paying today?"}, "blank": "paga", "verified": false},
  {"id": "l7-056", "type": "word", "pt": "abrir", "en": "to open", "level": 7, "unit": "l7-daily", "topic": "verbs", "example": {"pt": "A loja abre às nove.", "en": "The shop opens at nine."}, "blank": "abre", "verified": false},
  {"id": "l7-057", "type": "word", "pt": "fechar", "en": "to close, to shut", "level": 7, "unit": "l7-daily", "topic": "verbs", "example": {"pt": "Fecha a porta, por favor.", "en": "Close the door, please."}, "blank": "Fecha", "verified": false},
  {"id": "l7-058", "type": "word", "pt": "começar", "en": "to start, to begin", "level": 7, "unit": "l7-daily", "topic": "verbs", "example": {"pt": "O filme começa às dez.", "en": "The film starts at ten."}, "blank": "começa", "verified": false},
  {"id": "l7-059", "type": "word", "pt": "acabar", "en": "to finish, to end", "level": 7, "unit": "l7-daily", "topic": "verbs", "note": "*Acabar de* + verb = to have just: *acabei de* chegar.", "example": {"pt": "A aula acaba às seis.", "en": "The class ends at six."}, "blank": "acaba", "verified": false},
  {"id": "l7-060", "type": "phrase", "pt": "Vamos comer alguma coisa?", "en": "Shall we get something to eat?", "level": 7, "unit": "l7-daily", "topic": "verbs", "example": {"pt": "Tenho fome. Vamos comer alguma coisa?", "en": "I'm hungry. Shall we get something to eat?"}, "blank": "comer", "verified": false}
]
