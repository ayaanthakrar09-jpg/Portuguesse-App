[
  {"id": "l6-001", "type": "phrase", "pt": "Acho que sim.", "en": "I think so.", "level": 6, "unit": "l6-opinions", "topic": "opinions", "example": {"pt": "Vai chover? Acho que sim.", "en": "Is it going to rain? I think so."}, "blank": "sim", "verified": false},
  {"id": "l6-002", "type": "phrase", "pt": "Acho que não.", "en": "I don't think so.", "level": 6, "unit": "l6-opinions", "topic": "opinions", "example": {"pt": "Ele vem? Acho que não.", "en": "Is he coming? I don't think so."}, "blank": "não", "verified": false},
  {"id": "l6-003", "type": "phrase", "pt": "na minha opinião", "en": "in my opinion", "level": 6, "unit": "l6-opinions", "topic": "opinions", "example": {"pt": "Na minha opinião, o filme é muito longo.", "en": "In my opinion, the film is too long."}, "blank": "opinião", "verified": false},
  {"id": "l6-004", "type": "phrase", "pt": "para mim", "en": "for me, in my view", "level": 6, "unit": "l6-opinions", "topic": "opinions", "example": {"pt": "Para mim, o Porto é a cidade mais bonita.", "en": "For me, Porto is the most beautiful city."}, "blank": "mim", "verified": false},
  {"id": "l6-005", "type": "word", "pt": "achar", "en": "to think (have an opinion)", "level": 6, "unit": "l6-opinions", "topic": "opinions", "note": "Acho que + normal verb; não acho que + subjunctive.", "example": {"pt": "O que achas do meu plano?", "en": "What do you think of my plan?"}, "blank": "achas", "verified": false},
  {"id": "l6-006", "type": "word", "pt": "Depende.", "en": "It depends.", "level": 6, "unit": "l6-opinions", "topic": "opinions", "example": {"pt": "Vens connosco? Depende.", "en": "Are you coming with us? It depends."}, "blank": "Depende", "verified": false},
  {"id": "l6-007", "type": "phrase", "pt": "Tenho a certeza.", "en": "I'm sure.", "level": 6, "unit": "l6-opinions", "topic": "opinions", "example": {"pt": "Tens a certeza? Sim, tenho a certeza.", "en": "Are you sure? Yes, I'm sure."}, "blank": "certeza", "verified": false},
  {"id": "l6-008", "type": "phrase", "pt": "Não faço ideia.", "en": "I have no idea.", "level": 6, "unit": "l6-opinions", "topic": "opinions", "example": {"pt": "Onde está a Ana? Não faço ideia.", "en": "Where's Ana? I have no idea."}, "blank": "ideia", "verified": false},
  {"id": "l6-009", "type": "phrase", "pt": "Parece-me bem.", "en": "Sounds good to me.", "level": 6, "unit": "l6-opinions", "topic": "opinions", "example": {"pt": "Jantar às oito? Parece-me bem.", "en": "Dinner at eight? Sounds good to me."}, "blank": "Parece-me", "verified": false},
  {"id": "l6-010", "type": "word", "pt": "sinceramente", "en": "honestly", "level": 6, "unit": "l6-opinions", "topic": "opinions", "example": {"pt": "Sinceramente, não gostei do filme.", "en": "Honestly, I didn't like the film."}, "blank": "Sinceramente", "verified": false},
  {"id": "l6-011", "type": "phrase", "pt": "por outro lado", "en": "on the other hand", "level": 6, "unit": "l6-opinions", "topic": "opinions", "example": {"pt": "É caro, mas por outro lado é muito bom.", "en": "It's expensive, but on the other hand it's very good."}, "blank": "outro", "verified": false},
  {"id": "l6-012", "type": "phrase", "pt": "Tens razão.", "en": "You're right.", "level": 6, "unit": "l6-debate", "topic": "debate", "formality": "informal", "note": "Formal: Tem razão.", "example": {"pt": "Tens razão, desculpa.", "en": "You're right, sorry."}, "blank": "razão", "verified": false},
  {"id": "l6-013", "type": "word", "pt": "Concordo.", "en": "I agree.", "level": 6, "unit": "l6-debate", "topic": "debate", "note": "Concordar com = to agree with.", "example": {"pt": "Concordo contigo, é uma boa ideia.", "en": "I agree with you, it's a good idea."}, "blank": "Concordo", "verified": false},
  {"id": "l6-014", "type": "phrase", "pt": "Não concordo.", "en": "I don't agree.", "level": 6, "unit": "l6-debate", "topic": "debate", "example": {"pt": "Desculpa, mas não concordo.", "en": "Sorry, but I don't agree."}, "blank": "concordo", "verified": false},
  {"id": "l6-015", "type": "word", "pt": "Claro!", "en": "Of course!", "level": 6, "unit": "l6-debate", "topic": "debate", "example": {"pt": "Podes ajudar-me? Claro!", "en": "Can you help me? Of course!"}, "blank": "Claro", "verified": false},
  {"id": "l6-016", "type": "word", "pt": "Pois.", "en": "Right. / I see.", "level": 6, "unit": "l6-debate", "topic": "debate", "note": "Very Portuguese: shows you're listening or agreeing. Pois é! = Exactly! / It certainly is!", "example": {"pt": "Está muito calor hoje. Pois é!", "en": "It's very hot today. It certainly is!"}, "blank": "Pois", "verified": false},
  {"id": "l6-017", "type": "phrase", "pt": "Nem pensar!", "en": "No way!", "level": 6, "unit": "l6-debate", "topic": "debate", "example": {"pt": "Ir a pé até lá? Nem pensar!", "en": "Walk all the way there? No way!"}, "blank": "pensar", "verified": false},
  {"id": "l6-018", "type": "phrase", "pt": "se calhar", "en": "maybe, perhaps", "level": 6, "unit": "l6-debate", "topic": "debate", "note": "Very common in Portugal, with a normal verb: Se calhar chove.", "example": {"pt": "Se calhar vou amanhã.", "en": "Maybe I'll go tomorrow."}, "blank": "calhar", "verified": false},
  {"id": "l6-019", "type": "word", "pt": "Exatamente!", "en": "Exactly!", "level": 6, "unit": "l6-debate", "topic": "debate", "alternatives": ["Exactamente!"], "example": {"pt": "Então o problema é o preço? Exatamente!", "en": "So the problem is the price? Exactly!"}, "blank": "Exatamente", "verified": false},
  {"id": "l6-020", "type": "phrase", "pt": "Não é bem assim.", "en": "That's not quite right.", "level": 6, "unit": "l6-debate", "topic": "debate", "example": {"pt": "Não é bem assim, deixa-me explicar.", "en": "That's not quite right, let me explain."}, "blank": "assim", "verified": false},
  {"id": "l6-021", "type": "phrase", "pt": "Isso é verdade.", "en": "That's true.", "level": 6, "unit": "l6-debate", "topic": "debate", "example": {"pt": "Isso é verdade, não tinha pensado nisso.", "en": "That's true, I hadn't thought of that."}, "blank": "verdade", "verified": false},
  {"id": "l6-022", "type": "phrase", "pt": "Pode ser.", "en": "Maybe. / OK, why not.", "level": 6, "unit": "l6-debate", "topic": "debate", "example": {"pt": "Vamos ao cinema? Pode ser.", "en": "Shall we go to the cinema? OK, why not."}, "blank": "ser", "verified": false},
  {"id": "l6-023", "type": "word", "pt": "primeiro", "en": "first (of all)", "level": 6, "unit": "l6-story", "topic": "story", "example": {"pt": "Primeiro fomos ao museu.", "en": "First we went to the museum."}, "blank": "Primeiro", "verified": false},
  {"id": "l6-024", "type": "word", "pt": "depois", "en": "then, afterwards", "level": 6, "unit": "l6-story", "topic": "story", "example": {"pt": "Depois fomos jantar.", "en": "Then we went for dinner."}, "blank": "Depois", "verified": false},
  {"id": "l6-025", "type": "word", "pt": "finalmente", "en": "finally, at last", "level": 6, "unit": "l6-story", "topic": "story", "example": {"pt": "Finalmente chegámos a casa.", "en": "We finally got home."}, "blank": "Finalmente", "verified": false},
  {"id": "l6-026", "type": "phrase", "pt": "de repente", "en": "suddenly", "level": 6, "unit": "l6-story", "topic": "story", "example": {"pt": "De repente, começou a chover.", "en": "Suddenly it started to rain."}, "blank": "repente", "verified": false},
  {"id": "l6-027", "type": "word", "pt": "entretanto", "en": "meanwhile", "level": 6, "unit": "l6-story", "topic": "story", "example": {"pt": "Entretanto, o Pedro chegou.", "en": "Meanwhile, Pedro arrived."}, "blank": "Entretanto", "verified": false},
  {"id": "l6-028", "type": "phrase", "pt": "há dois anos", "en": "two years ago", "level": 6, "unit": "l6-story", "topic": "story", "note": "Há + amount of time = ago.", "example": {"pt": "Mudei-me para Lisboa há dois anos.", "en": "I moved to Lisbon two years ago."}, "blank": "anos", "verified": false},
  {"id": "l6-029", "type": "phrase", "pt": "uma vez", "en": "once", "level": 6, "unit": "l6-story", "topic": "story", "example": {"pt": "Uma vez perdi-me no Porto.", "en": "Once I got lost in Porto."}, "blank": "vez", "verified": false},
  {"id": "l6-030", "type": "phrase", "pt": "no dia seguinte", "en": "the next day", "level": 6, "unit": "l6-story", "topic": "story", "example": {"pt": "No dia seguinte fomos a Sintra.", "en": "The next day we went to Sintra."}, "blank": "seguinte", "verified": false},
  {"id": "l6-031", "type": "word", "pt": "Imagina!", "en": "Guess what! / Imagine that!", "level": 6, "unit": "l6-story", "topic": "story", "formality": "informal", "example": {"pt": "Imagina que encontrei o Pedro no comboio!", "en": "Guess what, I bumped into Pedro on the train!"}, "blank": "Imagina", "verified": false},
  {"id": "l6-032", "type": "phrase", "pt": "E então?", "en": "And then? / So?", "level": 6, "unit": "l6-story", "topic": "story", "example": {"pt": "E então? O que aconteceu?", "en": "And then? What happened?"}, "blank": "então", "verified": false},
  {"id": "l6-033", "type": "phrase", "pt": "Aconteceu uma coisa engraçada.", "en": "Something funny happened.", "level": 6, "unit": "l6-story", "topic": "story", "alternatives": ["Uma coisa engraçada aconteceu."], "example": {"pt": "Ontem aconteceu uma coisa engraçada.", "en": "Something funny happened yesterday."}, "blank": "aconteceu", "verified": false},
  {"id": "l6-034", "type": "word", "pt": "notícia", "gender": "f", "en": "piece of news", "level": 6, "unit": "l6-news", "topic": "news", "note": "As notícias = the news.", "example": {"pt": "Viste as notícias hoje?", "en": "Did you see the news today?"}, "blank": "notícias", "verified": false},
  {"id": "l6-035", "type": "word", "pt": "jornal", "gender": "m", "en": "newspaper", "level": 6, "unit": "l6-news", "topic": "news", "example": {"pt": "Leio o jornal todas as manhãs.", "en": "I read the paper every morning."}, "blank": "jornal", "verified": false},
  {"id": "l6-036", "type": "word", "pt": "governo", "gender": "m", "en": "government", "level": 6, "unit": "l6-news", "topic": "news", "example": {"pt": "O governo anunciou novas medidas.", "en": "The government announced new measures."}, "blank": "governo", "verified": false},
  {"id": "l6-037", "type": "word", "pt": "eleições", "en": "elections", "level": 6, "unit": "l6-news", "topic": "news", "note": "Always plural: as eleições.", "example": {"pt": "As eleições são em outubro.", "en": "The elections are in October."}, "blank": "eleições", "verified": false},
  {"id": "l6-038", "type": "word", "pt": "greve", "gender": "f", "en": "strike", "level": 6, "unit": "l6-news", "topic": "news", "note": "Fazer greve = to go on strike.", "example": {"pt": "Amanhã há greve dos comboios.", "en": "There's a train strike tomorrow."}, "blank": "greve", "verified": false},
  {"id": "l6-039", "type": "word", "pt": "preço", "gender": "m", "en": "price", "level": 6, "unit": "l6-news", "topic": "news", "example": {"pt": "O preço das casas subiu muito.", "en": "House prices have gone up a lot."}, "blank": "preço", "verified": false},
  {"id": "l6-040", "type": "word", "pt": "crise", "gender": "f", "en": "crisis", "level": 6, "unit": "l6-news", "topic": "news", "example": {"pt": "A crise da habitação é um grande problema.", "en": "The housing crisis is a big problem."}, "blank": "crise", "verified": false},
  {"id": "l6-041", "type": "word", "pt": "câmara municipal", "gender": "f", "en": "town hall, council", "level": 6, "unit": "l6-news", "topic": "news", "note": "Often just a Câmara.", "example": {"pt": "A câmara municipal fica na praça.", "en": "The town hall is on the square."}, "blank": "municipal", "verified": false},
  {"id": "l6-042", "type": "word", "pt": "segundo", "en": "according to", "level": 6, "unit": "l6-news", "topic": "news", "example": {"pt": "Segundo o jornal, a greve acabou.", "en": "According to the paper, the strike is over."}, "blank": "Segundo", "verified": false},
  {"id": "l6-043", "type": "word", "pt": "aumentar", "en": "to increase, to go up", "level": 6, "unit": "l6-news", "topic": "news", "example": {"pt": "Os preços vão aumentar.", "en": "Prices are going to go up."}, "blank": "aumentar", "verified": false},
  {"id": "l6-044", "type": "word", "pt": "desemprego", "gender": "m", "en": "unemployment", "level": 6, "unit": "l6-news", "topic": "news", "example": {"pt": "O desemprego desceu este ano.", "en": "Unemployment has fallen this year."}, "blank": "desemprego", "verified": false},
  {"id": "l6-045", "type": "word", "pt": "ambiente", "gender": "m", "en": "environment", "level": 6, "unit": "l6-nature", "topic": "nature", "note": "O meio ambiente is also used.", "example": {"pt": "Temos de proteger o ambiente.", "en": "We have to protect the environment."}, "blank": "ambiente", "verified": false},
  {"id": "l6-046", "type": "word", "pt": "reciclar", "en": "to recycle", "level": 6, "unit": "l6-nature", "topic": "nature", "example": {"pt": "Aqui reciclamos o vidro e o plástico.", "en": "Here we recycle glass and plastic."}, "blank": "reciclamos", "verified": false},
  {"id": "l6-047", "type": "word", "pt": "lixo", "gender": "m", "en": "rubbish", "level": 6, "unit": "l6-nature", "topic": "nature", "example": {"pt": "Leva o lixo lá para fora.", "en": "Take the rubbish out."}, "blank": "lixo", "verified": false},
  {"id": "l6-048", "type": "word", "pt": "serra", "gender": "f", "en": "mountain range, hills", "level": 6, "unit": "l6-nature", "topic": "nature", "note": "As in a Serra da Estrela.", "example": {"pt": "No inverno vamos à serra.", "en": "In winter we go up into the mountains."}, "blank": "serra", "verified": false},
  {"id": "l6-049", "type": "word", "pt": "rio", "gender": "m", "en": "river", "level": 6, "unit": "l6-nature", "topic": "nature", "example": {"pt": "O rio Douro passa pelo Porto.", "en": "The River Douro runs through Porto."}, "blank": "rio", "verified": false},
  {"id": "l6-050", "type": "word", "pt": "mar", "gender": "m", "en": "sea", "level": 6, "unit": "l6-nature", "topic": "nature", "example": {"pt": "A água do mar está fria.", "en": "The sea is cold."}, "blank": "mar", "verified": false},
  {"id": "l6-051", "type": "word", "pt": "incêndio", "gender": "m", "en": "fire", "level": 6, "unit": "l6-nature", "topic": "nature", "example": {"pt": "No verão há muitos incêndios.", "en": "In summer there are a lot of wildfires."}, "blank": "incêndios", "verified": false},
  {"id": "l6-052", "type": "word", "pt": "seca", "gender": "f", "en": "drought", "level": 6, "unit": "l6-nature", "topic": "nature", "example": {"pt": "O Alentejo sofre com a seca.", "en": "The Alentejo suffers from drought."}, "blank": "seca", "verified": false},
  {"id": "l6-053", "type": "word", "pt": "poupar", "en": "to save (money, water)", "level": 6, "unit": "l6-nature", "topic": "nature", "example": {"pt": "Temos de poupar água.", "en": "We have to save water."}, "blank": "poupar", "verified": false},
  {"id": "l6-054", "type": "word", "pt": "campo", "gender": "m", "en": "countryside (also: field)", "level": 6, "unit": "l6-nature", "topic": "nature", "example": {"pt": "Os meus avós vivem no campo.", "en": "My grandparents live in the countryside."}, "blank": "campo", "verified": false},
  {"id": "l6-055", "type": "word", "pt": "alterações climáticas", "en": "climate change", "level": 6, "unit": "l6-nature", "topic": "nature", "note": "Always plural in Portuguese: as alterações climáticas.", "example": {"pt": "As alterações climáticas preocupam muita gente.", "en": "Climate change worries a lot of people."}, "blank": "climáticas", "verified": false}
]
