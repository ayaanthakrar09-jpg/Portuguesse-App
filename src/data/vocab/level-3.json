  {"id": "l3-020", "type": "phrase", "pt": "Não me sinto bem.", "en": "I don't feel well.", "level": 3, "unit": "l3-health", "topic": "health", "example": {"pt": "Não me sinto bem, vou para casa.", "en": "I don't feel well, I'm going home."}, "blank": "sinto", "verified": false},
