  {
    "id": "g-demonstratives",
    "title": "este, esse, aquele",
    "summary": "this, that, and that over there",
    "focus": "word",
    "intro": [
      "Portuguese has three words where English has two: este (this, near me), esse (that, near you) and aquele (that, over there, away from us both).",
      "They change like o and a: este, esta, estes, estas; esse, essa, esses, essas; aquele, aquela, aqueles, aquelas.",
      "For a thing you don't name, or an idea, use isto, isso, aquilo: O que é isto? (What's this?)"
    ],
    "tables": [
      { "verb": "demonstratives", "caption": "este, esse, aquele", "listen": "form", "rows": [
        { "person": "near me", "form": "este · esta" },
        { "person": "near you", "form": "esse · essa" },
        { "person": "over there", "form": "aquele · aquela" },
        { "person": "a thing, an idea", "form": "isto · isso · aquilo" }
      ] }
    ],
    "examples": [
      { "pt": "Este café está frio.", "en": "This coffee is cold." },
      { "pt": "Esse livro é teu?", "en": "Is that book (near you) yours?" },
      { "pt": "Aquela casa é muito antiga.", "en": "That house over there is very old." },
      { "pt": "Isso mesmo!", "en": "Exactly! That's it!" }
    ],
    "notes": [
      "They join with de and em like o and a do: de + este = deste, em + esse = nesse, em + aquele = naquele.",
      "Isso! or Isso mesmo! is a very common way to say \"Exactly!\""
    ],
    "drills": [
      { "type": "sentence", "hint": "this, near me", "before": "", "after": " café está frio.", "answer": "Este", "en": "This coffee is cold." },
      { "type": "sentence", "hint": "that, over there", "before": "", "after": " casa é muito antiga.", "answer": "Aquela", "en": "That house over there is very old." },
      { "type": "sentence", "hint": "that, near you", "before": "", "after": " livro é teu?", "answer": "Esse", "en": "Is that book (near you) yours?" },
      { "type": "sentence", "hint": "these, near me", "before": "", "after": " sapatos são caros.", "answer": "Estes", "en": "These shoes are expensive." },
      { "type": "sentence", "hint": "this thing", "before": "O que é ", "after": "?", "answer": "isto", "en": "What's this?" },
      { "type": "sentence", "hint": "that", "before": "", "after": " mesmo!", "answer": "Isso", "en": "Exactly!" },
      { "type": "sentence", "hint": "de + este", "before": "Gosto ", "after": " restaurante.", "answer": "deste", "en": "I like this restaurant." },
      { "type": "sentence", "hint": "em + aquele", "before": "Moro ", "after": " prédio.", "answer": "naquele", "en": "I live in that building over there." },
      { "type": "choice", "before": "", "after": " flores são bonitas.", "options": ["Estas", "Estes"], "answer": "Estas", "en": "These flowers are pretty.", "why": "Flores is feminine plural: estas." },
