  {"id": "l5-006", "type": "word", "pt": "rede", "gender": "f", "en": "signal (phone network)", "level": 5, "unit": "l5-phone", "topic": "phone", "example": {"pt": "Aqui não há rede.", "en": "There's no signal here."}, "blank": "rede", "verified": false},
  {"id": "l5-007", "type": "word", "pt": "Está?", "en": "Hello? (answering the phone)", "level": 5, "unit": "l5-phone", "topic": "phone", "note": "How people answer the phone in Portugal. You'll also hear *Estou*? or *Sim*?", "example": {"pt": "Está? Quem fala?", "en": "Hello? Who's speaking?"}, "blank": "Está", "verified": false},
  {"id": "l5-008", "type": "phrase", "pt": "Quem fala?", "en": "Who's speaking?", "level": 5, "unit": "l5-phone", "topic": "phone", "example": {"pt": "Boa tarde. Quem fala?", "en": "Good afternoon. Who's speaking?"}, "blank": "fala", "verified": false},
  {"id": "l5-009", "type": "phrase", "pt": "Pode repetir, por favor?", "en": "Could you repeat that, please?", "level": 5, "unit": "l5-phone", "topic": "phone", "alternatives": ["Por favor, pode repetir?"], "example": {"pt": "Desculpe, não percebi. Pode repetir, por favor?", "en": "Sorry, I didn't catch that. Could you repeat it, please?"}, "blank": "repetir", "verified": false},
  {"id": "l5-010", "type": "phrase", "pt": "Está a ouvir-me?", "en": "Can you hear me?", "level": 5, "unit": "l5-phone", "topic": "phone", "formality": "formal", "note": "To a friend: *Estás a ouvir-me*?", "example": {"pt": "A ligação está má. Está a ouvir-me?", "en": "The line is bad. Can you hear me?"}, "blank": "ouvir-me", "verified": false},
