      { "type": "sentence", "verb": "dizer", "before": "Ela ", "after": " que não.", "answer": "disse", "en": "She said no." },
      { "type": "sentence", "verb": "ver", "before": "Ontem ", "after": " um filme muito bom.", "answer": "vi", "en": "Yesterday I saw a really good film." },
