      { "type": "sentence", "verb": "morar", "before": "Onde ", "after": " tu?", "answer": "moras", "en": "Where do you live?" },
      { "type": "sentence", "verb": "trabalhar", "before": "A Rita ", "after": " num hospital.", "answer": "trabalha", "en": "Rita works in a hospital." },
      { "type": "sentence", "verb": "apanhar", "before": "Nós ", "after": " o autocarro às oito.", "answer": "apanhamos", "en": "We catch the bus at eight." },
      { "type": "sentence", "verb": "gostar", "before": "Eles ", "after": " de café.", "answer": "gostam", "en": "They like coffee." },
      { "type": "sentence", "verb": "tomar", "before": "Eu ", "after": " o pequeno-almoço em casa.", "answer": "tomo", "en": "I have breakfast at home." }
    ],
    "verified": false
  },
