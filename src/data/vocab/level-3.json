[
  {"id": "l3-001", "type": "word", "pt": "trabalho", "gender": "m", "en": "work / job", "level": 3, "unit": "l3-work", "topic": "work", "example": {"pt": "Gosto muito do meu trabalho.", "en": "I really like my job."}, "blank": "trabalho", "verified": false},
  {"id": "l3-002", "type": "word", "pt": "emprego", "gender": "m", "en": "job (employment)", "level": 3, "unit": "l3-work", "topic": "work", "note": "Estar desempregado = to be unemployed.", "example": {"pt": "Ela está à procura de emprego.", "en": "She's looking for a job."}, "blank": "emprego", "verified": false},
  {"id": "l3-003", "type": "word", "pt": "escritório", "gender": "m", "en": "office", "level": 3, "unit": "l3-work", "topic": "work", "example": {"pt": "Trabalho num escritório no centro.", "en": "I work in an office in the centre."}, "blank": "escritório", "verified": false},
  {"id": "l3-004", "type": "word", "pt": "empresa", "gender": "f", "en": "company", "level": 3, "unit": "l3-work", "topic": "work", "example": {"pt": "A empresa tem cinquenta trabalhadores.", "en": "The company has fifty workers."}, "blank": "empresa", "verified": false},
  {"id": "l3-005", "type": "word", "pt": "chefe", "gender": "m", "en": "boss", "level": 3, "unit": "l3-work", "topic": "work", "note": "The same word for a woman: a chefe.", "example": {"pt": "O meu chefe é muito exigente.", "en": "My boss is very demanding."}, "blank": "chefe", "verified": false},
  {"id": "l3-006", "type": "word", "pt": "colega", "gender": "m", "en": "colleague", "level": 3, "unit": "l3-work", "topic": "work", "note": "o colega (a man), a colega (a woman).", "example": {"pt": "Almoço com os meus colegas.", "en": "I have lunch with my colleagues."}, "blank": "colegas", "verified": false},
  {"id": "l3-007", "type": "word", "pt": "reunião", "gender": "f", "en": "meeting", "level": 3, "unit": "l3-work", "topic": "work", "example": {"pt": "Tenho uma reunião às dez.", "en": "I have a meeting at ten."}, "blank": "reunião", "verified": false},
  {"id": "l3-008", "type": "word", "pt": "salário", "gender": "m", "en": "salary, wages", "level": 3, "unit": "l3-work", "topic": "work", "note": "Ordenado is also very common.", "example": {"pt": "O salário é pago no fim do mês.", "en": "The salary is paid at the end of the month."}, "blank": "salário", "verified": false},
  {"id": "l3-009", "type": "phrase", "pt": "O que fazes?", "en": "What do you do (for a living)?", "level": 3, "unit": "l3-work", "topic": "work", "formality": "informal", "note": "Formal: O que faz?", "example": {"pt": "O que fazes? Sou enfermeira.", "en": "What do you do? I'm a nurse."}, "blank": "fazes", "verified": false},
  {"id": "l3-010", "type": "phrase", "pt": "Trabalho por conta própria.", "en": "I'm self-employed.", "level": 3, "unit": "l3-work", "topic": "work", "example": {"pt": "Não tenho chefe, trabalho por conta própria.", "en": "I don't have a boss, I'm self-employed."}, "blank": "conta", "verified": false},
  {"id": "l3-011", "type": "phrase", "pt": "Estou de férias.", "en": "I'm on holiday.", "level": 3, "unit": "l3-work", "topic": "work", "example": {"pt": "Esta semana estou de férias.", "en": "I'm on holiday this week."}, "blank": "férias", "verified": false},
