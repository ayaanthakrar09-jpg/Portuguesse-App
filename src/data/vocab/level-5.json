  {"id": "l5-020", "type": "word", "pt": "fila", "gender": "f", "en": "queue", "level": 5, "unit": "l5-services", "topic": "services", "example": {"pt": "A fila está enorme.", "en": "The queue is huge."}, "blank": "fila", "verified": false},
  {"id": "l5-021", "type": "phrase", "pt": "Onde é que assino?", "en": "Where do I sign?", "level": 5, "unit": "l5-services", "topic": "services", "example": {"pt": "Está tudo certo. Onde é que assino?", "en": "Everything's fine. Where do I sign?"}, "blank": "assino", "verified": false},
