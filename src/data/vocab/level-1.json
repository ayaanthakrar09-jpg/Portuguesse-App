  { "id": "l1-029", "type": "word", "pt": "casa de banho", "gender": "f", "en": "toilet / bathroom", "level": 1, "unit": "l1-around", "topic": "travel", "example": { "pt": "A casa de banho fica ali.", "en": "The toilet is over there." }, "blank": "casa de banho", "verified": false },
  { "id": "l1-030", "type": "phrase", "pt": "à direita", "en": "on the right / to the right", "level": 1, "unit": "l1-around", "topic": "travel", "example": { "pt": "Vire à direita.", "en": "Turn right." }, "blank": "direita", "verified": false },
  { "id": "l1-031", "type": "phrase", "pt": "à esquerda", "en": "on the left / to the left", "level": 1, "unit": "l1-around", "topic": "travel", "example": { "pt": "O banco fica à esquerda.", "en": "The bank is on the left." }, "blank": "esquerda", "verified": false },
  { "id": "l1-032", "type": "word", "pt": "perto", "en": "near / nearby", "level": 1, "unit": "l1-around", "topic": "travel", "example": { "pt": "O hotel fica perto.", "en": "The hotel is nearby." }, "blank": "perto", "verified": false },
  { "id": "l1-033", "type": "phrase", "pt": "Onde fica a estação?", "en": "Where is the station?", "level": 1, "unit": "l1-around", "topic": "travel", "note": "Onde fica…? asks where a place is.", "example": { "pt": "Desculpe, onde fica a estação?", "en": "Excuse me, where is the station?" }, "blank": "fica", "verified": false },
  { "id": "l1-034", "type": "phrase", "pt": "Um bilhete para o Porto, por favor.", "en": "A ticket to Porto, please.", "level": 1, "unit": "l1-around", "topic": "travel", "example": { "pt": "Bom dia. Um bilhete para o Porto, por favor.", "en": "Good morning. A ticket to Porto, please." }, "blank": "bilhete", "verified": false },

