      { "type": "choice", "before": "O que é ", "after": " ali ao fundo?", "options": ["aquilo", "aquele"], "answer": "aquilo", "en": "What's that over there at the back?", "why": "A thing you can't name, with no noun after it: aquilo." },
      { "type": "choice", "before": "Queria ", "after": " bolo, se faz favor.", "options": ["este", "esta"], "answer": "este", "en": "I'd like this cake, please.", "why": "Bolo is masculine: este." }
    ],
    "verified": false
  }
]
