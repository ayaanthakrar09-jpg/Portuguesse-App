[
  { "id": "l1-001", "type": "word", "pt": "olá", "en": "hello", "level": 1, "unit": "l1-greetings", "topic": "greetings", "example": { "pt": "Olá, tudo bem?", "en": "Hi, how are things?" }, "blank": "Olá", "verified": false },
  { "id": "l1-002", "type": "phrase", "pt": "bom dia", "en": "good morning", "level": 1, "unit": "l1-greetings", "topic": "greetings", "example": { "pt": "Bom dia, Rita!", "en": "Good morning, Rita!" }, "blank": "dia", "verified": false },
  { "id": "l1-003", "type": "phrase", "pt": "boa tarde", "en": "good afternoon", "level": 1, "unit": "l1-greetings", "topic": "greetings", "example": { "pt": "Boa tarde, como estás?", "en": "Good afternoon, how are you?" }, "blank": "tarde", "verified": false },
  { "id": "l1-004", "type": "phrase", "pt": "boa noite", "en": "good evening / good night", "level": 1, "unit": "l1-greetings", "topic": "greetings", "example": { "pt": "Boa noite, até amanhã!", "en": "Good night, see you tomorrow!" }, "blank": "noite", "verified": false },
  { "id": "l1-005", "type": "word", "pt": "obrigado", "en": "thank you", "level": 1, "unit": "l1-greetings", "topic": "greetings", "alternatives": ["obrigada"], "note": "Men say obrigado, women say obrigada.", "example": { "pt": "Obrigado pela ajuda.", "en": "Thank you for the help." }, "blank": "Obrigado", "verified": false },
  { "id": "l1-006", "type": "phrase", "pt": "por favor", "en": "please", "level": 1, "unit": "l1-greetings", "topic": "greetings", "note": "Se faz favor is also very common in Portugal.", "example": { "pt": "Um café, por favor.", "en": "A coffee, please." }, "blank": "favor", "verified": false },
  { "id": "l1-007", "type": "word", "pt": "desculpa", "en": "sorry / excuse me", "level": 1, "unit": "l1-greetings", "topic": "greetings", "formality": "informal", "alternatives": ["desculpe"], "note": "With strangers, staff or older people: desculpe.", "example": { "pt": "Desculpa, podes ajudar-me?", "en": "Sorry, can you help me?" }, "blank": "Desculpa", "verified": false },
  { "id": "l1-008", "type": "word", "pt": "sim", "en": "yes", "level": 1, "unit": "l1-greetings", "topic": "greetings", "example": { "pt": "Sim, claro.", "en": "Yes, of course." }, "blank": "Sim", "verified": false },
  { "id": "l1-009", "type": "word", "pt": "não", "en": "no / not", "level": 1, "unit": "l1-greetings", "topic": "greetings", "example": { "pt": "Não, obrigado.", "en": "No, thank you." }, "blank": "Não", "verified": false },
  { "id": "l1-010", "type": "phrase", "pt": "Tudo bem?", "en": "How are things? / All good?", "level": 1, "unit": "l1-greetings", "topic": "greetings", "formality": "informal", "example": { "pt": "Olá, Ana! Tudo bem?", "en": "Hi, Ana! All good?" }, "blank": "bem", "verified": false },
  { "id": "l1-011", "type": "phrase", "pt": "até logo", "en": "see you later", "level": 1, "unit": "l1-greetings", "topic": "greetings", "example": { "pt": "Até logo, boa tarde!", "en": "See you later, have a good afternoon!" }, "blank": "logo", "verified": false },
  { "id": "l1-012", "type": "phrase", "pt": "com licença", "en": "excuse me (to get past)", "level": 1, "unit": "l1-greetings", "topic": "greetings", "example": { "pt": "Com licença, vou passar.", "en": "Excuse me, I'm coming through." }, "blank": "licença", "verified": false },

  { "id": "l1-013", "type": "word", "pt": "café", "gender": "m", "en": "coffee", "level": 1, "unit": "l1-cafe", "topic": "food", "note": "Um café in Portugal is a small espresso.", "example": { "pt": "Bebo um café de manhã.", "en": "I drink a coffee in the morning." }, "blank": "café", "verified": false },
  { "id": "l1-014", "type": "word", "pt": "água", "gender": "f", "en": "water", "level": 1, "unit": "l1-cafe", "topic": "food", "example": { "pt": "Uma água, por favor.", "en": "A water, please." }, "blank": "água", "verified": false },
  { "id": "l1-015", "type": "word", "pt": "pão", "gender": "m", "en": "bread", "level": 1, "unit": "l1-cafe", "topic": "food", "example": { "pt": "O pão está quente.", "en": "The bread is warm." }, "blank": "pão", "verified": false },
  { "id": "l1-016", "type": "word", "pt": "leite", "gender": "m", "en": "milk", "level": 1, "unit": "l1-cafe", "topic": "food", "example": { "pt": "O leite está frio.", "en": "The milk is cold." }, "blank": "leite", "verified": false },
  { "id": "l1-017", "type": "word", "pt": "pequeno-almoço", "gender": "m", "en": "breakfast", "level": 1, "unit": "l1-cafe", "topic": "food", "example": { "pt": "O pequeno-almoço é às oito.", "en": "Breakfast is at eight." }, "blank": "pequeno-almoço", "verified": false },
  { "id": "l1-018", "type": "word", "pt": "almoço", "gender": "m", "en": "lunch", "level": 1, "unit": "l1-cafe", "topic": "food", "example": { "pt": "O almoço está pronto.", "en": "Lunch is ready." }, "blank": "almoço", "verified": false },
  { "id": "l1-019", "type": "word", "pt": "jantar", "gender": "m", "en": "dinner", "level": 1, "unit": "l1-cafe", "topic": "food", "note": "Jantar is also the verb: to have dinner.", "example": { "pt": "O jantar está na mesa.", "en": "Dinner is on the table." }, "blank": "jantar", "verified": false },
  { "id": "l1-020", "type": "word", "pt": "conta", "gender": "f", "en": "bill", "level": 1, "unit": "l1-cafe", "topic": "food", "example": { "pt": "A conta, por favor.", "en": "The bill, please." }, "blank": "conta", "verified": false },
  { "id": "l1-021", "type": "word", "pt": "ementa", "gender": "f", "en": "menu", "level": 1, "unit": "l1-cafe", "topic": "food", "example": { "pt": "Pode trazer a ementa?", "en": "Can you bring the menu?" }, "blank": "ementa", "verified": false },
  { "id": "l1-022", "type": "phrase", "pt": "Queria um café, por favor.", "en": "I'd like a coffee, please.", "level": 1, "unit": "l1-cafe", "topic": "food", "alternatives": ["Queria um café, se faz favor."], "note": "Queria (I would like) is the polite way to order.", "example": { "pt": "Bom dia! Queria um café, por favor.", "en": "Good morning! I'd like a coffee, please." }, "blank": "Queria", "verified": false },
  { "id": "l1-023", "type": "phrase", "pt": "Mais alguma coisa?", "en": "Anything else?", "level": 1, "unit": "l1-cafe", "topic": "food", "note": "What staff ask when you order or pay.", "example": { "pt": "Mais alguma coisa? Não, obrigado.", "en": "Anything else? No, thank you." }, "blank": "alguma", "verified": false },

  { "id": "l1-024", "type": "word", "pt": "comboio", "gender": "m", "en": "train", "level": 1, "unit": "l1-around", "topic": "travel", "example": { "pt": "O comboio chega às dez.", "en": "The train arrives at ten." }, "blank": "comboio", "verified": false },
  { "id": "l1-025", "type": "word", "pt": "autocarro", "gender": "m", "en": "bus", "level": 1, "unit": "l1-around", "topic": "travel", "example": { "pt": "Apanho o autocarro todos os dias.", "en": "I take the bus every day." }, "blank": "autocarro", "verified": false },
  { "id": "l1-026", "type": "word", "pt": "estação", "gender": "f", "en": "station", "level": 1, "unit": "l1-around", "topic": "travel", "example": { "pt": "A estação é perto daqui.", "en": "The station is near here." }, "blank": "estação", "verified": false },
  { "id": "l1-027", "type": "word", "pt": "bilhete", "gender": "m", "en": "ticket", "level": 1, "unit": "l1-around", "topic": "travel", "example": { "pt": "O bilhete custa três euros.", "en": "The ticket costs three euros." }, "blank": "bilhete", "verified": false },
