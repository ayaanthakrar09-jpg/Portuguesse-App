  {"id": "l9-044", "type": "word", "pt": "jogar", "en": "to play (a game, a sport)", "level": 9, "unit": "l9-verbs", "topic": "verbs", "note": "For music: *tocar* guitarra.", "example": {"pt": "Jogamos futebol ao sábado.", "en": "We play football on Saturdays."}, "blank": "Jogamos", "verified": false},
  {"id": "l9-045", "type": "word", "pt": "aprender", "en": "to learn", "level": 9, "unit": "l9-verbs", "topic": "verbs", "example": {"pt": "Estou a aprender português.", "en": "I'm learning Portuguese."}, "blank": "aprender", "verified": false},
