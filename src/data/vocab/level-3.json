  {"id": "l3-016", "type": "word", "pt": "receita", "gender": "f", "en": "prescription (also: recipe)", "level": 3, "unit": "l3-health", "topic": "health", "example": {"pt": "O médico passou-me uma receita.", "en": "The doctor gave me a prescription."}, "blank": "receita", "verified": false},
