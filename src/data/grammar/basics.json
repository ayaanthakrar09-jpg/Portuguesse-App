[
  {
    "id": "g-gender-plural",
    "title": "o, a and plurals",
    "summary": "masculine, feminine, and more than one",
    "focus": "word",
    "intro": [
      "Every noun is masculine (o) or feminine (a). Most words ending in -o are masculine and most ending in -a are feminine, but not all: o dia, o mapa, a mão.",
      "For more than one, o becomes os and a becomes as, and the noun usually just adds -s: o livro → os livros, a casa → as casas.",
      "Other endings change a little more:"
    ],
    "tables": [
      { "verb": "plurals", "caption": "Singular and plural", "listen": "both", "rows": [
        { "person": "o livro", "form": "os livros" },
        { "person": "a estação", "form": "as estações" },
        { "person": "o hotel", "form": "os hotéis" },
        { "person": "a flor", "form": "as flores" },
        { "person": "o país", "form": "os países" },
        { "person": "o homem", "form": "os homens" }
      ] }
    ],
    "examples": [
      { "pt": "Os comboios são rápidos.", "en": "The trains are fast." },
      { "pt": "Tenho dois irmãos e duas irmãs.", "en": "I have two brothers and two sisters." },
      { "pt": "As estações estão cheias.", "en": "The stations are full." },
      { "pt": "Queria dois pães, se faz favor.", "en": "I'd like two bread rolls, please." }
    ],
    "notes": [
      "Words ending in -ão have three possible plurals: -ões (estação → estações), -ães (pão → pães, cão → cães) and -ãos (mão → mãos, irmão → irmãos). Most take -ões; learn the others as you meet them.",
      "Describing words follow the noun: uma casa bonita, duas casas bonitas, um carro bonito, dois carros bonitos.",
      "A / some: um, uma, uns, umas."
    ],
    "drills": [
      { "type": "sentence", "hint": "livro", "before": "um livro, dois ", "after": "", "answer": "livros", "en": "one book, two books" },
      { "type": "sentence", "hint": "casa", "before": "uma casa, duas ", "after": "", "answer": "casas", "en": "one house, two houses" },
      { "type": "sentence", "hint": "estação", "before": "uma estação, duas ", "after": "", "answer": "estações", "en": "one station, two stations" },
      { "type": "sentence", "hint": "hotel", "before": "um hotel, dois ", "after": "", "answer": "hotéis", "en": "one hotel, two hotels" },
      { "type": "sentence", "hint": "flor", "before": "uma flor, duas ", "after": "", "answer": "flores", "en": "one flower, two flowers" },
      { "type": "sentence", "hint": "homem", "before": "um homem, dois ", "after": "", "answer": "homens", "en": "one man, two men" },
      { "type": "sentence", "hint": "pão", "before": "um pão, dois ", "after": "", "answer": "pães", "en": "one bread roll, two bread rolls" },
      { "type": "sentence", "hint": "irmão", "before": "um irmão, dois ", "after": "", "answer": "irmãos", "en": "one brother, two brothers" },
      { "type": "choice", "before": "", "after": " mapa é antigo.", "options": ["O", "A"], "answer": "O", "en": "The map is old.", "why": "Mapa ends in -a but is masculine." },
      { "type": "choice", "before": "", "after": " mão está fria.", "options": ["O", "A"], "answer": "A", "en": "The hand is cold.", "why": "Mão is feminine, even though it doesn't end in -a." },
      { "type": "choice", "before": "", "after": " dia está bonito.", "options": ["O", "A"], "answer": "O", "en": "It's a lovely day.", "why": "Dia ends in -a but is masculine." },
      { "type": "choice", "before": "As casas são ", "after": ".", "options": ["bonitas", "bonitos"], "answer": "bonitas", "en": "The houses are pretty.", "why": "Casas is feminine plural, so the describing word is too." }
    ],
    "verified": false
  },
  {
    "id": "g-contractions",
    "title": "do, na, ao, pelo",
    "summary": "little words that join together",
    "focus": "word",
    "intro": [
      "The small words de (of, from), em (in, on), a (to) and por (through, by, for) join with o, a, os, as to make one word.",
      "This isn't optional: you always say do, never de o."
    ],
    "tables": [
      { "verb": "de", "meaning": "of, from", "caption": "de with o, a, os, as", "listen": "form", "rows": [
        { "person": "de + o / a", "form": "do · da" },
        { "person": "de + os / as", "form": "dos · das" }
      ] },
      { "verb": "em", "meaning": "in, on", "caption": "em with o, a, os, as", "listen": "form", "rows": [
        { "person": "em + o / a", "form": "no · na" },
        { "person": "em + os / as", "form": "nos · nas" },
        { "person": "em + um / uma", "form": "num · numa" }
      ] },
      { "verb": "a", "meaning": "to, at", "caption": "a with o, a, os, as", "listen": "form", "rows": [
        { "person": "a + o / a", "form": "ao · à" },
        { "person": "a + os / as", "form": "aos · às" }
      ] },
      { "verb": "por", "meaning": "through, by, for", "caption": "por with o, a, os, as", "listen": "form", "rows": [
        { "person": "por + o / a", "form": "pelo · pela" },
        { "person": "por + os / as", "form": "pelos · pelas" }
      ] }
    ],
    "examples": [
      { "pt": "Sou do Porto.", "en": "I'm from Porto." },
      { "pt": "Moro na Rua Augusta.", "en": "I live on Rua Augusta." },
      { "pt": "Vou ao café.", "en": "I'm going to the café." },
      { "pt": "Obrigado pela ajuda.", "en": "Thanks for the help." }
    ],
    "notes": [
      "Cities without an article don't join: Sou de Lisboa, Vou a Lisboa. But o Porto has one: Sou do Porto, Vou ao Porto.",
      "À (a + a) has a grave accent. It sounds almost the same as a, so you'll mostly notice it in writing: Vou à praia.",
      "Times use às: às seis (at six). But à uma (at one), because uma is singular."
    ],
    "drills": [
      { "type": "sentence", "hint": "de + o", "before": "Sou ", "after": " Porto.", "answer": "do", "en": "I'm from Porto." },
      { "type": "sentence", "hint": "de + a", "before": "A casa ", "after": " Ana é grande.", "answer": "da", "en": "Ana's house is big." },
      { "type": "sentence", "hint": "de + os", "before": "Gosto ", "after": " teus amigos.", "answer": "dos", "en": "I like your friends." },
      { "type": "sentence", "hint": "em + a", "before": "O livro está ", "after": " mesa.", "answer": "na", "en": "The book is on the table." },
      { "type": "sentence", "hint": "em + o", "before": "Moro ", "after": " centro.", "answer": "no", "en": "I live in the centre." },
      { "type": "sentence", "hint": "em + as", "before": "Há muita gente ", "after": " ruas.", "answer": "nas", "en": "There are lots of people in the streets." },
      { "type": "sentence", "hint": "em + um", "before": "Moro ", "after": " apartamento pequeno.", "answer": "num", "en": "I live in a small flat." },
      { "type": "sentence", "hint": "a + o", "before": "Vou ", "after": " cinema.", "answer": "ao", "en": "I'm going to the cinema." },
      { "type": "sentence", "hint": "a + a", "before": "Vamos ", "after": " praia.", "answer": "à", "en": "We're going to the beach." },
      { "type": "sentence", "hint": "a + as", "before": "Chego ", "after": " seis.", "answer": "às", "en": "I arrive at six." },
      { "type": "sentence", "hint": "por + a", "before": "Obrigado ", "after": " ajuda.", "answer": "pela", "en": "Thanks for the help." },
      { "type": "sentence", "hint": "por + o", "before": "Passamos ", "after": " centro.", "answer": "pelo", "en": "We go through the centre." }
    ],
    "verified": false
  },
  {
    "id": "g-possessives",
    "title": "o meu, a minha",
    "summary": "my, your, his, her, our",
    "focus": "word",
    "intro": [
      "In Portugal, my, your and our come with o or a in front: o meu carro (my car), a minha casa (my house).",
      "They match the thing owned, not the owner: a minha irmã (my sister), whether a man or a woman says it."
    ],
    "tables": [
      { "verb": "possessives", "caption": "Possessives, masculine and feminine", "listen": "form", "rows": [
        { "person": "my", "form": "o meu · a minha" },
        { "person": "your (tu)", "form": "o teu · a tua" },
        { "person": "your (polite)", "form": "o seu · a sua" },
        { "person": "his / her (after the noun)", "form": "dele · dela" },
        { "person": "our", "form": "o nosso · a nossa" },
        { "person": "their (after the noun)", "form": "deles · delas" }
      ] }
    ],
    "examples": [
      { "pt": "O meu irmão vive em Lisboa.", "en": "My brother lives in Lisbon." },
      { "pt": "A tua mãe é muito simpática.", "en": "Your mother is very nice." },
      { "pt": "O carro dele é novo.", "en": "His car is new." },
      { "pt": "Os nossos amigos vêm jantar.", "en": "Our friends are coming to dinner." }
    ],
    "notes": [
      "Plurals: os meus, as minhas, os teus, as tuas, os nossos, as nossas.",
      "For his and her, Portugal usually puts dele / dela after the noun: o carro dele (his car), a casa dela (her house). O seu carro normally means your car, said politely.",
      "Leaving out the o / a (minha mãe) sounds Brazilian. In Portugal, keep it: a minha mãe."
    ],
    "drills": [
      { "type": "sentence", "hint": "my", "before": "", "after": " irmão vive em Lisboa.", "answer": "O meu", "en": "My brother lives in Lisbon." },
      { "type": "sentence", "hint": "my", "before": "", "after": " casa é pequena.", "answer": "A minha", "en": "My house is small." },
      { "type": "sentence", "hint": "my", "before": "", "after": " pais vivem no Algarve.", "answer": "Os meus", "en": "My parents live in the Algarve." },
      { "type": "sentence", "hint": "your, tu", "before": "Onde estão ", "after": " chaves?", "answer": "as tuas", "en": "Where are your keys?" },
      { "type": "sentence", "hint": "your, tu", "before": "Este é ", "after": " quarto.", "answer": "o teu", "en": "This is your room." },
      { "type": "sentence", "hint": "our", "before": "", "after": " filha estuda em Coimbra.", "answer": "A nossa", "en": "Our daughter studies in Coimbra." },
      { "type": "sentence", "hint": "our", "before": "", "after": " amigos vêm jantar.", "answer": "Os nossos", "en": "Our friends are coming to dinner." },
      { "type": "sentence", "hint": "his", "before": "O carro ", "after": " é novo.", "answer": "dele", "en": "His car is new." },
      { "type": "sentence", "hint": "her", "before": "A mala ", "after": " é azul.", "answer": "dela", "en": "Her bag is blue." },
      { "type": "choice", "before": "A ", "after": " irmã é professora.", "options": ["minha", "meu"], "answer": "minha", "en": "My sister is a teacher.", "why": "Irmã is feminine, so minha, whoever is speaking." },
      { "type": "choice", "before": "Os ", "after": " livros estão na mesa.", "options": ["meus", "minhas"], "answer": "meus", "en": "My books are on the table.", "why": "Livros is masculine plural: meus." },
      { "type": "choice", "before": "O senhor tem ", "after": " bilhete?", "options": ["o seu", "o teu"], "answer": "o seu", "en": "Do you have your ticket, sir?", "why": "Speaking politely (o senhor): o seu." }
