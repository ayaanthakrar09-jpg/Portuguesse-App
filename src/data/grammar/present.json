      { "type": "form", "verb": "morar", "person": "tu", "answer": "moras" },
      { "type": "form", "verb": "trabalhar", "person": "ela", "answer": "trabalha" },
      { "type": "form", "verb": "estudar", "person": "nós", "answer": "estudamos" },
      { "type": "form", "verb": "comprar", "person": "eles", "answer": "compram" },
      { "type": "form", "verb": "falar", "person": "vocês", "answer": "falam" },
