  {"id": "l3-013", "type": "word", "pt": "estômago", "gender": "m", "en": "stomach", "level": 3, "unit": "l3-health", "topic": "health", "example": {"pt": "Dói-me o estômago.", "en": "My stomach hurts."}, "blank": "estômago", "verified": false},
