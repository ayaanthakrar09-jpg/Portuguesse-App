      { "type": "form", "person": "nós", "answer": "temos" },
      { "type": "form", "person": "eles", "answer": "têm" },
      { "type": "form", "person": "você", "answer": "tem" },
      { "type": "sentence", "before": "Eu ", "after": " vinte anos.", "answer": "tenho", "en": "I'm twenty." },
      { "type": "sentence", "before": "Quantos anos ", "after": " tu?", "answer": "tens", "en": "How old are you?" },
      { "type": "sentence", "before": "A Rita ", "after": " dez anos.", "answer": "tem", "en": "Rita is ten." },
      { "type": "sentence", "before": "Nós ", "after": " fome.", "answer": "temos", "en": "We're hungry." },
      { "type": "sentence", "before": "Eles ", "after": " dois filhos.", "answer": "têm", "en": "They have two children." },
      { "type": "sentence", "before": "Eu ", "after": " de trabalhar amanhã.", "answer": "tenho", "en": "I have to work tomorrow." }
