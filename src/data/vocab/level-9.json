  {"id": "l9-057", "type": "word", "pt": "outro", "en": "other, another", "level": 9, "unit": "l9-questions", "topic": "amounts", "alternatives": ["outra"], "note": "No *um* before it: *outro* café = another coffee.", "example": {"pt": "Queria outro café, por favor.", "en": "I'd like another coffee, please."}, "blank": "outro", "verified": false},
  {"id": "l9-058", "type": "word", "pt": "cada", "en": "each, every", "level": 9, "unit": "l9-questions", "topic": "amounts", "example": {"pt": "Cada pessoa paga dez euros.", "en": "Each person pays ten euros."}, "blank": "Cada", "verified": false},
