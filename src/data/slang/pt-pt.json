  "items": [
    { "id": "s-01", "group": "chat", "pt": "fixe", "en": "cool, great", "formality": "informal", "region": "All of Portugal", "example": { "pt": "A festa foi muito fixe.", "en": "The party was really cool." }, "note": "The most common way to say \"cool\" in Portugal. Tudo fixe? = All good?", "confidence": "high", "verified": false },
    { "id": "s-02", "group": "chat", "pt": "bué", "en": "really, very; loads", "formality": "informal", "region": "All of Portugal (started in Lisbon)", "example": { "pt": "Está bué frio hoje.", "en": "It's really cold today." }, "note": "Bué de + noun = loads of: bué de gente (loads of people). Very common with young people.", "confidence": "high", "verified": false },
    { "id": "s-03", "group": "chat", "pt": "ya", "en": "yeah", "formality": "informal", "region": "All of Portugal", "example": { "pt": "Ya, vou contigo.", "en": "Yeah, I'll come with you." }, "confidence": "high", "verified": false },
    { "id": "s-04", "group": "chat", "pt": "bora!", "en": "let's go! come on!", "formality": "informal", "region": "All of Portugal", "example": { "pt": "Bora ao cinema?", "en": "Shall we go to the cinema?" }, "note": "Short for vamos embora (let's go).", "confidence": "high", "verified": false },
    { "id": "s-05", "group": "chat", "pt": "pá", "en": "filler word, like \"man\" or \"mate\"", "formality": "informal", "region": "All of Portugal", "example": { "pt": "Ó pá, não sei!", "en": "Oh man, I don't know!" }, "note": "Comes from rapaz (boy). Used all the time with people you're relaxed with.", "confidence": "high", "verified": false },
    { "id": "s-06", "group": "chat", "pt": "então?", "en": "so? how's it going?", "formality": "informal", "region": "All of Portugal", "example": { "pt": "Olá! Então, tudo bem?", "en": "Hi! So, how's it going?" }, "note": "Então means \"so\" or \"then\", but on its own it's a very common friendly greeting.", "confidence": "high", "verified": false },

    { "id": "s-07", "group": "describe", "pt": "porreiro", "en": "great, nice; a decent person", "formality": "informal", "region": "All of Portugal", "example": { "pt": "O teu irmão é muito porreiro.", "en": "Your brother is a really nice guy." }, "note": "For a woman: porreira.", "confidence": "high", "verified": false },
    { "id": "s-08", "group": "describe", "pt": "giro / gira", "en": "cute, pretty; nice, interesting", "formality": "informal", "region": "All of Portugal", "example": { "pt": "Que vestido tão giro!", "en": "What a cute dress!" }, "note": "Also for ideas: Que giro! = How nice! / How interesting!", "confidence": "high", "verified": false },
    { "id": "s-09", "group": "describe", "pt": "chato / chata", "en": "annoying; boring", "formality": "informal", "region": "All of Portugal", "example": { "pt": "Este filme é tão chato.", "en": "This film is so boring." }, "note": "Que chatice! = What a pain!", "confidence": "high", "verified": false },
    { "id": "s-10", "group": "describe", "pt": "ganda", "en": "huge, great, massive", "formality": "informal", "region": "All of Portugal", "example": { "pt": "Foi uma ganda festa!", "en": "It was a massive party!" }, "note": "A spoken, squashed form of grande, said with emphasis.", "confidence": "high", "verified": false },
    { "id": "s-11", "group": "describe", "pt": "cena", "en": "thing, stuff, situation", "formality": "informal", "region": "All of Portugal, mostly young people", "example": { "pt": "Que cena estranha.", "en": "What a weird thing." }, "note": "Literally \"scene\". Young people use it for almost anything.", "confidence": "high", "verified": false },
    { "id": "s-12", "group": "describe", "pt": "baril", "en": "cool, great", "formality": "informal", "region": "Mainly Lisbon", "example": { "pt": "O concerto foi baril.", "en": "The concert was great." }, "note": "May sound dated or local. Ask your native speaker whether people still say it.", "confidence": "medium", "verified": false },

    { "id": "s-13", "group": "people", "pt": "malta", "en": "the gang, folks, people", "formality": "informal", "region": "All of Portugal", "example": { "pt": "A malta vai jantar fora hoje.", "en": "The gang is going out for dinner tonight." }, "note": "Olá, malta! = Hi, everyone!", "confidence": "high", "verified": false },
    { "id": "s-14", "group": "people", "pt": "gajo", "en": "guy, bloke", "formality": "informal", "region": "All of Portugal", "example": { "pt": "Quem é aquele gajo?", "en": "Who's that guy?" }, "note": "The female form, gaja, often sounds disrespectful. Better to avoid it.", "confidence": "high", "verified": false },
    { "id": "s-15", "group": "people", "pt": "puto", "en": "kid, young lad", "formality": "informal", "region": "Portugal", "example": { "pt": "Quando era puto, vivia no Porto.", "en": "When I was a kid, I lived in Porto." }, "note": "Harmless in Portugal, but an insult in Brazil. The female form, puta, is a very rude word everywhere.", "confidence": "high", "verified": false },

    { "id": "s-16", "group": "cafe", "pt": "uma bica", "en": "an espresso", "formality": "informal", "region": "Lisbon and the south", "example": { "pt": "Uma bica, se faz favor.", "en": "An espresso, please." }, "note": "Um café is understood everywhere.", "confidence": "high", "verified": false },
    { "id": "s-17", "group": "cafe", "pt": "um cimbalino", "en": "an espresso", "formality": "informal", "region": "Porto and the north", "example": { "pt": "Um cimbalino, por favor.", "en": "An espresso, please." }, "note": "Traditional, from the name of an old coffee machine. Um café also works.", "confidence": "medium", "verified": false },
    { "id": "s-18", "group": "cafe", "pt": "uma imperial", "en": "a small draught beer", "formality": "informal", "region": "Lisbon and the south", "example": { "pt": "Duas imperiais, por favor.", "en": "Two small beers, please." }, "confidence": "high", "verified": false },
    { "id": "s-19", "group": "cafe", "pt": "um fino", "en": "a small draught beer", "formality": "informal", "region": "Porto and the north", "example": { "pt": "Um fino bem fresquinho, se faz favor.", "en": "A nice cold small beer, please." }, "confidence": "high", "verified": false },
    { "id": "s-20", "group": "cafe", "pt": "tasca", "en": "a small, simple traditional restaurant", "formality": "informal", "region": "All of Portugal", "example": { "pt": "Almoçámos numa tasca em Alfama.", "en": "We had lunch in a little tasca in Alfama." }, "confidence": "high", "verified": false },

    { "id": "s-21", "group": "exclaim", "pt": "Fogo!", "en": "Damn! Blimey!", "literal": "fire", "formality": "informal", "region": "All of Portugal", "example": { "pt": "Fogo, perdi o comboio!", "en": "Damn, I missed the train!" }, "note": "A polite way to swear.", "confidence": "high", "verified": false },
    { "id": "s-22", "group": "exclaim", "pt": "desenrascar-se", "en": "to improvise your way out of a problem, to get by", "formality": "informal", "region": "All of Portugal", "example": { "pt": "Não sei como, mas desenrasquei-me.", "en": "I don't know how, but I managed." }, "note": "Desenrascanço, the art of getting by, is often called a very Portuguese skill.", "confidence": "high", "verified": false },
    { "id": "s-23", "group": "exclaim", "pt": "estar com os copos", "en": "to be drunk", "literal": "to be with the glasses", "formality": "informal", "region": "All of Portugal", "example": { "pt": "Ele já está com os copos.", "en": "He's already drunk." }, "confidence": "medium", "verified": false },

    { "id": "s-24", "group": "watch", "pt": "rapariga", "en": "girl", "formality": "neutral", "region": "Portugal", "example": { "pt": "A rapariga do café é simpática.", "en": "The girl at the café is nice." }, "note": "A normal word in Portugal, but offensive in Brazil. See also puto under People.", "confidence": "high", "verified": false },
    { "id": "s-25", "group": "watch", "pt": "a casa de banho", "en": "the toilet", "formality": "neutral", "region": "Portugal", "example": { "pt": "Onde é a casa de banho?", "en": "Where is the toilet?" }, "note": "In Brazil it's o banheiro. In Portugal, banheiro means a lifeguard.", "confidence": "high", "verified": false },

    { "id": "s-26", "group": "rude", "pt": "porra", "en": "damn, crap", "formality": "rude", "region": "All of Portugal", "example": { "pt": "Porra, outra vez?", "en": "Damn, again?" }, "note": "Milder than merda, but still not for polite company.", "confidence": "high", "verified": false },
    { "id": "s-27", "group": "rude", "pt": "merda", "en": "shit", "formality": "rude", "region": "All of Portugal", "example": { "pt": "Que merda!", "en": "What crap! / Damn it!" }, "confidence": "high", "verified": false },
    { "id": "s-28", "group": "rude", "pt": "foda-se", "en": "fuck!", "formality": "very rude", "region": "All of Portugal", "example": { "pt": "Foda-se, que frio!", "en": "Fuck, it's cold!" }, "note": "Very common as an exclamation, but strong.", "confidence": "high", "verified": false },
    { "id": "s-29", "group": "rude", "pt": "caralho", "en": "fuck! (as an exclamation)", "formality": "very rude", "region": "All of Portugal, especially the north", "example": { "pt": "Caralho, que susto!", "en": "Fuck, what a fright!" }, "note": "Literally a vulgar word for penis. In the north it's used constantly as an exclamation.", "confidence": "high", "verified": false }
  ]
}
