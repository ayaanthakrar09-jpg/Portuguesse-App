  { "id": "l1-045", "type": "phrase", "pt": "Muito prazer.", "en": "Nice to meet you.", "level": 1, "unit": "l1-people", "topic": "people", "note": "Casually, people often just say: Prazer.", "example": { "pt": "Muito prazer, eu sou o Pedro.", "en": "Nice to meet you, I'm Pedro." }, "blank": "prazer", "verified": false },

  { "id": "l1-046", "type": "word", "pt": "um", "en": "one / a", "level": 1, "unit": "l1-time", "topic": "time", "alternatives": ["uma"], "note": "Um with masculine words, uma with feminine words.", "example": { "pt": "Um café e uma água, por favor.", "en": "A coffee and a water, please." }, "blank": "Um", "verified": false },
