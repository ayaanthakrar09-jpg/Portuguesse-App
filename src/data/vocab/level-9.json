[
  {"id": "l9-001", "type": "word", "pt": "coisa", "gender": "f", "en": "thing", "level": 9, "unit": "l9-things", "topic": "nouns", "example": {"pt": "Tenho uma coisa para ti.", "en": "I've got something for you."}, "blank": "coisa", "verified": false},
  {"id": "l9-002", "type": "word", "pt": "pessoa", "gender": "f", "en": "person", "level": 9, "unit": "l9-things", "topic": "nouns", "note": "Always *a pessoa*, for a man or a woman.", "example": {"pt": "É uma pessoa muito simpática.", "en": "He's a very nice person."}, "blank": "pessoa", "verified": false},
  {"id": "l9-003", "type": "word", "pt": "gente", "gender": "f", "en": "people", "level": 9, "unit": "l9-things", "topic": "nouns", "note": "In casual speech *a gente* also means 'we': *a gente* vai = we're going.", "example": {"pt": "Havia muita gente na praia.", "en": "There were lots of people on the beach."}, "blank": "gente", "verified": false},
  {"id": "l9-004", "type": "word", "pt": "homem", "gender": "m", "en": "man", "level": 9, "unit": "l9-things", "topic": "nouns", "example": {"pt": "Aquele homem é o meu vizinho.", "en": "That man is my neighbour."}, "blank": "homem", "verified": false},
  {"id": "l9-005", "type": "word", "pt": "mulher", "gender": "f", "en": "woman; wife", "level": 9, "unit": "l9-things", "topic": "nouns", "example": {"pt": "A mulher dele é médica.", "en": "His wife is a doctor."}, "blank": "mulher", "verified": false},
  {"id": "l9-006", "type": "word", "pt": "criança", "gender": "f", "en": "child", "level": 9, "unit": "l9-things", "topic": "nouns", "note": "Always *a criança*, even for a boy.", "example": {"pt": "As crianças estão a brincar no jardim.", "en": "The children are playing in the garden."}, "blank": "crianças", "verified": false},
  {"id": "l9-007", "type": "word", "pt": "nome", "gender": "m", "en": "name", "level": 9, "unit": "l9-things", "topic": "nouns", "example": {"pt": "Qual é o teu nome?", "en": "What's your name?"}, "blank": "nome", "verified": false},
  {"id": "l9-008", "type": "word", "pt": "parte", "gender": "f", "en": "part", "level": 9, "unit": "l9-things", "topic": "nouns", "example": {"pt": "A melhor parte do filme é o fim.", "en": "The best part of the film is the end."}, "blank": "parte", "verified": false},
  {"id": "l9-009", "type": "word", "pt": "maneira", "gender": "f", "en": "way, manner", "level": 9, "unit": "l9-things", "topic": "nouns", "example": {"pt": "Não há outra maneira.", "en": "There's no other way."}, "blank": "maneira", "verified": false},
  {"id": "l9-010", "type": "word", "pt": "ideia", "gender": "f", "en": "idea", "level": 9, "unit": "l9-things", "topic": "nouns", "example": {"pt": "Tenho uma ideia!", "en": "I've got an idea!"}, "blank": "ideia", "verified": false},
  {"id": "l9-011", "type": "word", "pt": "verdade", "gender": "f", "en": "truth", "level": 9, "unit": "l9-things", "topic": "nouns", "note": "*É verdade* = that's true. *A sério?* = really?", "example": {"pt": "Diz-me a verdade.", "en": "Tell me the truth."}, "blank": "verdade", "verified": false},
  {"id": "l9-012", "type": "phrase", "pt": "Não é nada de especial.", "en": "It's nothing special.", "level": 9, "unit": "l9-things", "topic": "nouns", "example": {"pt": "Gostas do restaurante? Não é nada de especial.", "en": "Do you like the restaurant? It's nothing special."}, "blank": "especial", "verified": false},
  {"id": "l9-013", "type": "word", "pt": "cidade", "gender": "f", "en": "city, town", "level": 9, "unit": "l9-places", "topic": "places", "example": {"pt": "Lisboa é uma cidade antiga.", "en": "Lisbon is an old city."}, "blank": "cidade", "verified": false},
  {"id": "l9-014", "type": "word", "pt": "país", "gender": "m", "en": "country (nation)", "level": 9, "unit": "l9-places", "topic": "places", "note": "The countryside is *o campo*.", "example": {"pt": "Portugal é um país pequeno.", "en": "Portugal is a small country."}, "blank": "país", "verified": false},
  {"id": "l9-015", "type": "word", "pt": "aldeia", "gender": "f", "en": "village", "level": 9, "unit": "l9-places", "topic": "places", "example": {"pt": "Os meus avós vivem numa aldeia.", "en": "My grandparents live in a village."}, "blank": "aldeia", "verified": false},
  {"id": "l9-016", "type": "word", "pt": "sítio", "gender": "m", "en": "place, spot", "level": 9, "unit": "l9-places", "topic": "places", "note": "Very common in Portugal; *lugar* is also used.", "example": {"pt": "Conheço um sítio ótimo para jantar.", "en": "I know a great place for dinner."}, "blank": "sítio", "verified": false},
  {"id": "l9-017", "type": "word", "pt": "lugar", "gender": "m", "en": "place; seat", "level": 9, "unit": "l9-places", "topic": "places", "example": {"pt": "Este lugar está livre?", "en": "Is this seat free?"}, "blank": "lugar", "verified": false},
  {"id": "l9-018", "type": "word", "pt": "casa", "gender": "f", "en": "house, home", "level": 9, "unit": "l9-places", "topic": "places", "note": "*Em casa* = at home; *para casa* = (going) home, with no *a*.", "example": {"pt": "Estou cansado, vou para casa.", "en": "I'm tired, I'm going home."}, "blank": "casa", "verified": false},
  {"id": "l9-019", "type": "word", "pt": "escola", "gender": "f", "en": "school", "level": 9, "unit": "l9-places", "topic": "places", "example": {"pt": "A escola fica ao lado do parque.", "en": "The school is next to the park."}, "blank": "escola", "verified": false},
  {"id": "l9-020", "type": "word", "pt": "hospital", "gender": "m", "en": "hospital", "level": 9, "unit": "l9-places", "topic": "places", "example": {"pt": "Ela trabalha no hospital.", "en": "She works at the hospital."}, "blank": "hospital", "verified": false},
  {"id": "l9-021", "type": "word", "pt": "igreja", "gender": "f", "en": "church", "level": 9, "unit": "l9-places", "topic": "places", "example": {"pt": "A igreja fica na praça.", "en": "The church is in the square."}, "blank": "igreja", "verified": false},
  {"id": "l9-022", "type": "word", "pt": "centro", "gender": "m", "en": "centre", "level": 9, "unit": "l9-places", "topic": "places", "example": {"pt": "Moramos no centro da cidade.", "en": "We live in the city centre."}, "blank": "centro", "verified": false},
  {"id": "l9-023", "type": "word", "pt": "prédio", "gender": "m", "en": "building, block of flats", "level": 9, "unit": "l9-places", "topic": "places", "example": {"pt": "Moro no terceiro andar deste prédio.", "en": "I live on the third floor of this building."}, "blank": "prédio", "verified": false},
  {"id": "l9-024", "type": "phrase", "pt": "Onde é que fica?", "en": "Where is it?", "level": 9, "unit": "l9-places", "topic": "places", "alternatives": ["Onde fica?"], "note": "*É que* after a question word is very common in Portugal and changes nothing.", "example": {"pt": "Há uma farmácia aqui perto? Onde é que fica?", "en": "Is there a chemist's near here? Where is it?"}, "blank": "fica", "verified": false},
  {"id": "l9-025", "type": "word", "pt": "cedo", "en": "early", "level": 9, "unit": "l9-time", "topic": "time", "example": {"pt": "Amanhã tenho de acordar cedo.", "en": "Tomorrow I have to get up early."}, "blank": "cedo", "verified": false},
  {"id": "l9-026", "type": "word", "pt": "tarde", "en": "late (in the day)", "level": 9, "unit": "l9-time", "topic": "time", "note": "*A tarde* is also 'the afternoon'.", "example": {"pt": "Já é tarde, vamos embora.", "en": "It's late, let's go."}, "blank": "tarde", "verified": false},
  {"id": "l9-027", "type": "word", "pt": "logo", "en": "later (today); straight away", "level": 9, "unit": "l9-time", "topic": "time", "note": "*Até logo* = see you later.", "example": {"pt": "Falamos logo à noite.", "en": "We'll talk tonight."}, "blank": "logo", "verified": false},
  {"id": "l9-028", "type": "word", "pt": "antes", "en": "before, earlier", "level": 9, "unit": "l9-time", "topic": "time", "note": "Before a noun or verb: *antes de*.", "example": {"pt": "Eu cheguei antes.", "en": "I got here earlier."}, "blank": "antes", "verified": false},
  {"id": "l9-029", "type": "word", "pt": "durante", "en": "during", "level": 9, "unit": "l9-time", "topic": "time", "example": {"pt": "Durmo sempre durante a viagem.", "en": "I always sleep during the journey."}, "blank": "durante", "verified": false},
  {"id": "l9-030", "type": "word", "pt": "dia", "gender": "m", "en": "day", "level": 9, "unit": "l9-time", "topic": "time", "note": "Ends in -a but is masculine: *o dia*.", "example": {"pt": "Que dia é hoje?", "en": "What day is it today?"}, "blank": "dia", "verified": false},
  {"id": "l9-031", "type": "word", "pt": "mês", "gender": "m", "en": "month", "level": 9, "unit": "l9-time", "topic": "time", "example": {"pt": "Vou a Lisboa no próximo mês.", "en": "I'm going to Lisbon next month."}, "blank": "mês", "verified": false},
  {"id": "l9-032", "type": "word", "pt": "ano", "gender": "m", "en": "year", "level": 9, "unit": "l9-time", "topic": "time", "example": {"pt": "Moro aqui há três anos.", "en": "I've lived here for three years."}, "blank": "anos", "verified": false},
  {"id": "l9-033", "type": "word", "pt": "hora", "gender": "f", "en": "hour", "level": 9, "unit": "l9-time", "topic": "time", "example": {"pt": "O filme dura duas horas.", "en": "The film lasts two hours."}, "blank": "horas", "verified": false},
  {"id": "l9-034", "type": "word", "pt": "minuto", "gender": "m", "en": "minute", "level": 9, "unit": "l9-time", "topic": "time", "example": {"pt": "Espera cinco minutos.", "en": "Wait five minutes."}, "blank": "minutos", "verified": false},
  {"id": "l9-035", "type": "word", "pt": "próximo", "en": "next", "level": 9, "unit": "l9-time", "topic": "time", "alternatives": ["próxima"], "example": {"pt": "Até à próxima semana!", "en": "See you next week!"}, "blank": "próxima", "verified": false},
  {"id": "l9-036", "type": "phrase", "pt": "Daqui a pouco.", "en": "In a little while.", "level": 9, "unit": "l9-time", "topic": "time", "example": {"pt": "O jantar está pronto daqui a pouco.", "en": "Dinner will be ready in a little while."}, "blank": "pouco", "verified": false},
  {"id": "l9-037", "type": "word", "pt": "trabalhar", "en": "to work", "level": 9, "unit": "l9-verbs", "topic": "verbs", "example": {"pt": "Trabalho num hotel.", "en": "I work in a hotel."}, "blank": "Trabalho", "verified": false},
  {"id": "l9-038", "type": "word", "pt": "morar", "en": "to live (in a place)", "level": 9, "unit": "l9-verbs", "topic": "verbs", "alternatives": ["viver"], "note": "*Viver* is also used for where you live.", "example": {"pt": "Moro em Lisboa.", "en": "I live in Lisbon."}, "blank": "Moro", "verified": false},
  {"id": "l9-039", "type": "word", "pt": "viver", "en": "to live (be alive, live a life)", "level": 9, "unit": "l9-verbs", "topic": "verbs", "example": {"pt": "A minha avó viveu noventa anos.", "en": "My grandmother lived to ninety."}, "blank": "viveu", "verified": false},
  {"id": "l9-040", "type": "word", "pt": "mudar", "en": "to change; to move (house)", "level": 9, "unit": "l9-verbs", "topic": "verbs", "example": {"pt": "Vamos mudar de casa em março.", "en": "We're moving house in March."}, "blank": "mudar", "verified": false},
  {"id": "l9-041", "type": "word", "pt": "tentar", "en": "to try", "level": 9, "unit": "l9-verbs", "topic": "verbs", "example": {"pt": "Vou tentar chegar a horas.", "en": "I'll try to arrive on time."}, "blank": "tentar", "verified": false},
  {"id": "l9-042", "type": "word", "pt": "usar", "en": "to use; to wear", "level": 9, "unit": "l9-verbs", "topic": "verbs", "example": {"pt": "Posso usar o teu computador?", "en": "Can I use your computer?"}, "blank": "usar", "verified": false},
